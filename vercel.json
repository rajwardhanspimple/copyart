{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/model/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sticker_img/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/work/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/reunimos", "destination": "/reunimos/index.html" },
    { "source": "/adrive", "destination": "/adrive/index.html" },
    { "source": "/teambition", "destination": "/teambition/index.html" },
    { "source": "/wasm_design_utils", "destination": "/wasm_design_utils/index.html" },
    { "source": "/inspire_mono", "destination": "/inspire_mono/index.html" },
    { "source": "/shore_icon", "destination": "/shore_icon/index.html" }
  ]
}
